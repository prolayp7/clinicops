# Supabase project (staging/production values are provisioned separately, never committed)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection used by Prisma (Supabase connection string)
DATABASE_URL=postgresql://user:password@localhost:5432/clinicops
DIRECT_URL=postgresql://user:password@localhost:5432/clinicops

# IANA timezone used to render clinic-local timestamps
CLINIC_TIMEZONE=America/New_York

# Fictional staging tests only; never enable demo seeding in production
E2E_SEED_PASSWORD=
ALLOW_DEMO_SEED=false

# Auth/Storage provider selection. Both default to "supabase" if unset — the self-hosted path is
# an additive alternative (plain Postgres + local disk), not a replacement. See
# src/lib/auth/providers and src/lib/storage/providers.
AUTH_PROVIDER=supabase
STORAGE_PROVIDER=supabase

# Required only when STORAGE_PROVIDER=selfhosted: a private directory outside the web root where
# uploaded files are written (e.g. /var/lib/clinicops/storage in production).
LOCAL_STORAGE_ROOT=

# Required only when STORAGE_PROVIDER=selfhosted: server-only secret used to HMAC-sign short-lived
# file-download tokens (the local-disk equivalent of a Supabase signed URL). Generate with
# `openssl rand -base64 32`; never reuse across environments.
FILE_SIGNING_SECRET=

# Public base URL used to build password-reset links (no trailing slash)
APP_URL=http://localhost:3000

# Outbound mail for password reset and appointment reminders. Delivery fails closed when absent;
# message contents are never written to application logs. e.g. smtp://user:pass@smtp.example.com:587
SMTP_URL=
MAIL_FROM=

# Vercel Cron bearer secret for /api/cron/reminders. Generate a unique value per environment.
CRON_SECRET=
